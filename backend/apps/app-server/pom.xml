<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.internaladmin</groupId>
        <artifactId>internal-admin-template</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>app-server</artifactId>
    <name>app-server</name>
    <description>唯一应用装配和启动模块：聚合模块、配置与 Liquibase 主入口</description>

    <dependencies>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>platform-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>platform-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>platform-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-iam</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-site</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-audit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-warehouse</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-ai-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.internaladmin</groupId>
            <artifactId>module-agent-warehouse-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 仅提供运行时 OpenAPI JSON；Swagger UI 不在 0.1 范围内。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
        <!-- 集成测试（@SpringBootTest / MockMvc / MockMultipartFile） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4：MockMvc 自动配置独立模块（spring-boot-webmvc-test） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 越权测试（@WithMockUser 模拟已认证用户） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
