<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- SQLite-compatible test bootstrap; all subsequent production changeSets remain unchanged. -->
    <changeSet id="agent-gate-bootstrap" author="test">
        <createTable tableName="ai_conversation">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="ai_run">
            <column name="run_id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="conversation_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="client_request_id" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="error_code" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="ai_run" indexName="idx_ai_run_conversation_status">
            <column name="conversation_id"/>
            <column name="status"/>
        </createIndex>
        <createTable tableName="ai_message">
            <column name="message_id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="conversation_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="run_id" type="VARCHAR(36)"/>
            <column name="role" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="content" type="TEXT"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="ai_message" indexName="idx_ai_message_conversation">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
    <include file="db/changelog/2026-08-20-0002-active-run-reservation.xml"/>
    <include file="db/changelog/2026-08-21-0001-conversation-history-contract.xml"/>
    <include file="db/changelog/2026-08-21-0002-message-scope-fingerprint.xml"/>
    <include file="db/changelog/2026-08-21-0003-memory-segment.xml"/>
    <include file="db/changelog/2026-08-23-0001-task-clarification-contract.xml"/>
    <include file="db/changelog/2026-08-29-0001-retry-run-contract.xml"/>
    <include file="db/changelog/2026-08-30-0001-knowledge-card.xml"/>
</databaseChangeLog>
