<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-02-0004-create-knowledge-drafts" author="template" dbms="postgresql">
        <createTable schemaName="ai_knowledge" tableName="ai_knowledge_draft">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="document_code" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="version_code" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(240)"><constraints nullable="false"/></column>
            <column name="creator_user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="file_asset_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="client_request_id" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="source_type" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="parser_version" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="content_hash" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="character_count" type="INTEGER"><constraints nullable="false"/></column>
            <column name="section_count" type="INTEGER"><constraints nullable="false"/></column>
            <column name="ignored_count" type="INTEGER"><constraints nullable="false"/></column>
            <column name="truncated" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="base_active_version_code" type="VARCHAR(80)"/>
            <column name="base_active_content_hash" type="VARCHAR(128)"/>
            <column name="error_code" type="VARCHAR(80)"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="expires_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint schemaName="ai_knowledge" tableName="ai_knowledge_draft"
                             columnNames="creator_user_id,client_request_id" constraintName="uk_ai_knowledge_draft_request"/>
        <addUniqueConstraint schemaName="ai_knowledge" tableName="ai_knowledge_draft"
                             columnNames="document_code,version_code" constraintName="uk_ai_knowledge_draft_document_version"/>
        <createIndex schemaName="ai_knowledge" tableName="ai_knowledge_draft"
                     indexName="idx_ai_knowledge_draft_document_version">
            <column name="document_code"/>
            <column name="version_code"/>
        </createIndex>
        <createIndex schemaName="ai_knowledge" tableName="ai_knowledge_draft"
                     indexName="idx_ai_knowledge_draft_creator_created">
            <column name="creator_user_id"/>
            <column name="created_at"/>
        </createIndex>
        <createTable schemaName="ai_knowledge" tableName="ai_knowledge_draft_section">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="draft_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="section_no" type="INTEGER"><constraints nullable="false"/></column>
            <column name="section_key" type="VARCHAR(240)"><constraints nullable="false"/></column>
            <column name="heading" type="VARCHAR(500)"/>
            <column name="content" type="TEXT"><constraints nullable="false"/></column>
            <column name="character_count" type="INTEGER"><constraints nullable="false"/></column>
            <column name="content_hash" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="change_type" type="VARCHAR(16)"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableSchemaName="ai_knowledge" baseTableName="ai_knowledge_draft_section"
                                 baseColumnNames="draft_id" referencedTableSchemaName="ai_knowledge"
                                 referencedTableName="ai_knowledge_draft" referencedColumnNames="id"
                                 constraintName="fk_ai_knowledge_draft_section_draft"/>
        <addUniqueConstraint schemaName="ai_knowledge" tableName="ai_knowledge_draft_section"
                             columnNames="draft_id,section_no" constraintName="uk_ai_knowledge_draft_section_no"/>
        <createIndex schemaName="ai_knowledge" tableName="ai_knowledge_draft_section"
                     indexName="idx_ai_knowledge_draft_section_key">
            <column name="draft_id"/>
            <column name="section_key"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
