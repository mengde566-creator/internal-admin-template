<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-08-24-0001-ai-observation-run-step-attempt-sqlite" author="研发工程师" dbms="sqlite">
        <createTable tableName="ai_observation_run">
            <column name="run_id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="error_code" type="VARCHAR(64)"/>
            <column name="started_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>
        <addColumn tableName="ai_observation_step">
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
        </addColumn>
        <createTable tableName="ai_observation_attempt">
            <column name="attempt_id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="step_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="attempt_no" type="INT"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="duration_ms" type="BIGINT"><constraints nullable="false"/></column>
            <column name="error_code" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="ai_observation_step" indexName="uk_obs_run_seq" unique="true">
            <column name="run_id"/><column name="sequence_no"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
