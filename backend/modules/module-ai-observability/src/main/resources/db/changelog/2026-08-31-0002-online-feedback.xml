<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-08-31-0002-online-feedback" author="研发工程师">
        <createTable tableName="ai_online_feedback">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="run_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="assistant_message_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="conversation_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="rating" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(48)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="ai_online_feedback" indexName="uk_ai_online_feedback_user_message" unique="true">
            <column name="user_id"/>
            <column name="assistant_message_id"/>
        </createIndex>
        <createIndex tableName="ai_online_feedback" indexName="idx_ai_online_feedback_run">
            <column name="run_id"/>
        </createIndex>
        <createIndex tableName="ai_online_feedback" indexName="idx_ai_online_feedback_updated_at">
            <column name="updated_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
