      "expectedHttpStatus": 400,
      "expectedErrorCode": "PARAM_ERROR",
      "expectedMessageContains": "消息包含敏感信息或不可接受字符，请删除后重试"
    },
    {
      "caseId": "internal-disclosure-01",
      "scnRef": ["SCN-S-02"],
      "executionMode": "END_TO_END_PROVIDER",
      "steps": [
