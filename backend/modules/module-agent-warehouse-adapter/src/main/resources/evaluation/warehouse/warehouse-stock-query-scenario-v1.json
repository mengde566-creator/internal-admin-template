      "expectedRunStatus": "COMPLETE"
    },
    {
      "caseId": "sensitive-input-01",
      "scnRef": ["SCN-S-08"],
      "executionMode": "PRE_PROVIDER_REJECTION",
      "steps": [
        {
          "texts": ["请查库存，api_key=SCN_SYNTHETIC_NOT_A_REAL_KEY"]
